<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net481</TargetFramework>
        <LangVersion>latest</LangVersion>
        <RootNamespace>VNEI</RootNamespace>
        <AssemblyName>VNEI</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <WarningLevel>4</WarningLevel>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <!-- keep bin\Debug\VNEI.dll (no net48 subfolder) for deploy.sh and the Unity project -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JotunnLib" Version="2.28.0" />
        <PackageReference Include="YamlDotNet" Version="16.3.0" />
        <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.43" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Microsoft.CSharp" />
        <Reference Include="System" />
        <Reference Include="System.Core" />
        <Reference Include="System.Data" />
        <Reference Include="System.Data.DataSetExtensions" />
        <Reference Include="System.Xml" />
        <Reference Include="System.Xml.Linq" />
        <!--
        <Reference Include="AugaAPI">
            <HintPath>Libs/AugaAPI.dll</HintPath>
            <SpecificVersion>False</SpecificVersion>
        </Reference>
        -->
    </ItemGroup>

    <ItemGroup>
        <Reference Include="EpicLoot">
            <HintPath Condition="Exists('$(VALHEIM_INSTALL)\BepInEx\plugins\EpicLoot\EpicLoot.dll')">$(VALHEIM_INSTALL)\BepInEx\plugins\EpicLoot\EpicLoot.dll</HintPath>
            <HintPath Condition="Exists('$(VALHEIM_INSTALL)\BepInEx\plugins\RandyKnapp-EpicLoot\EpicLoot.dll')">$(VALHEIM_INSTALL)\BepInEx\plugins\RandyKnapp-EpicLoot\EpicLoot.dll</HintPath>
            <HintPath Condition="Exists('$(R2MODMAN_INSTALL)\BepInEx\plugins\RandyKnapp-EpicLoot\EpicLoot.dll')">$(R2MODMAN_INSTALL)\BepInEx\plugins\RandyKnapp-EpicLoot\EpicLoot.dll</HintPath>
            <HintPath Condition="Exists('$(R2MODMAN_INSTALL)\BepInEx\plugins\RandyKnapp-EpicLoot\EpicLoot.dll.old')">$(R2MODMAN_INSTALL)\BepInEx\plugins\RandyKnapp-EpicLoot\EpicLoot.dll.old</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Localization/English.json" />
        <None Remove="Localization/German.json" />
        <None Remove="Localization/Config.json" />
        <None Remove="ItemBlacklist.json" />
        <None Remove="VNEI_AssetBundle" />
        <EmbeddedResource Include="Localization/English.json" />
        <EmbeddedResource Include="Localization/German.json" />
        <EmbeddedResource Include="Localization/Config.json" />
        <EmbeddedResource Include="ItemBlacklist.json" />
        <EmbeddedResource Include="VNEI_AssetBundle" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\CHANGELOG.md" Link="CHANGELOG.md" />
        <Content Include="..\README.md" Link="README.md" />
        <Content Include="..\API.md" Link="API.md" />
        <Content Include="..\CONTRIBUTING.md" Link="CONTRIBUTING.md" />
        <Content Include="..\manifest.json" Link="manifest.json" />
    </ItemGroup>

    <!-- must always exist locally, see CONTRIBUTING.md -->
    <Import Project="../Environment.props" />

</Project>
